<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Buddy</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-100">
    <div class="flex">
        <aside class="w-64 bg-gray-900 text-gray-100 min-h-screen">
            <div class="px-5 py-4 text-xl font-bold tracking-wide">Admin</div>
            <nav class="px-2 space-y-1">
                <a href="/admin/buddy/list" class="block px-3 py-2 rounded bg-gray-800 text-white">Buddies</a>
                <a href="/admin/category/list" class="block px-3 py-2 rounded hover:bg-gray-800">Categories</a>
            </nav>
        </aside>
        <main class="flex-1 p-6 space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-semibold text-gray-800">Buddies</h1>
                    <div class="text-sm text-gray-500">Dashboard > Buddies</div>
                </div>
                <a href="/admin/buddy/create"
                    class="inline-flex items-center bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded shadow">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20"
                        fill="currentColor">
                        <path
                            d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" />
                    </svg>
                    Add Buddy
                </a>
            </div>
            <div class="bg-white rounded-lg shadow ring-1 ring-gray-200">
                <div class="p-4 border-b flex items-center gap-3">
                    <input id="buddySearchInput" type="text" placeholder="Tìm kiếm..."
                        class="w-64 px-3 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <span class="text-sm text-gray-500">Tổng: <%= buddies && buddies.length ? buddies.length : 0 %>
                    </span>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50 text-gray-700">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider">Name</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider">Category
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider">Age</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider">Gender
                                </th>
                                <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider">Breed
                                </th>
                                <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wider">Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody id="buddyTableBody" class="bg-white divide-y divide-gray-100">
                            <% if (buddies && buddies.length) { %>
                                <% buddies.forEach(buddy=> { %>
                                    <tr class="hover:bg-gray-50 data-row">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                            <a class="text-indigo-600 hover:text-indigo-800"
                                                href="/admin/buddy/detail/<%= buddy._id %>">
                                                <%= buddy.name %>
                                            </a>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                            <%= buddy.category && buddy.category.name ? buddy.category.name : '-' %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                            <%= typeof buddy.age !=='undefined' ? buddy.age : '-' %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <span
                                                class="inline-flex items-center px-2 py-1 rounded text-xs font-medium <%= buddy.gender === 'Đực' ? 'bg-blue-100 text-blue-700' : 'bg-pink-100 text-pink-700' %>">
                                                <%= buddy.gender || '-' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                            <%= buddy.breed || '-' %>
                                        </td>
                                        <td
                                            class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                                            <a href="/admin/buddy/edit/<%= buddy._id %>"
                                                class="inline-flex items-center px-3 py-1.5 rounded bg-indigo-600 text-white hover:bg-indigo-700">Edit</a>
                                            <form action="/admin/buddy/delete/<%= buddy._id %>" method="POST"
                                                class="inline" onsubmit="return confirm('Xóa buddy này?')">
                                                <button type="submit"
                                                    class="inline-flex items-center px-3 py-1.5 rounded bg-red-600 text-white hover:bg-red-700">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <tr id="buddyNoResultsRow" class="hidden">
                                            <td colspan="6" class="px-6 py-10 text-center text-gray-500">Không có kết
                                                quả phù hợp</td>
                                        </tr>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" class="px-6 py-10 text-center text-gray-500">Chưa có
                                                    buddy nào.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
    <script>
        const s = document.getElementById('buddySearchInput');
        const body = document.getElementById('buddyTableBody');
        const noRow = document.getElementById('buddyNoResultsRow');
        const norm = (t) => (t || '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        const filter = () => {
            const q = norm(s.value);
            let shown = 0;
            const rows = body.querySelectorAll('tr.data-row');
            rows.forEach(r => {
                const text = norm(r.innerText);
                const hit = !q || text.includes(q);
                r.style.display = hit ? '' : 'none';
                if (hit) shown++;
            });
            if (noRow) noRow.style.display = shown === 0 && q ? '' : 'none';
        };
        s.addEventListener('input', filter);
    </script>
</body>

</html>